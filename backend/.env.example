# Server Configuration
PORT=8080
FRONTEND_URL=http://localhost:5173

# Execution Mode (all, server, worker)
RUN_MODE=all

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/creati?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Storage
S3_BUCKET=creati-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Platforms
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/platforms/youtube/callback

# Feature Flags
ENABLE_EVENT_SIMULATOR=true
CAN_USE_MAGIC_SYNC=true
